# 复制为 .env 使用（.env 不入库）。以下均为占位默认值，无任何真实配置。
ADMIN_PASSWORD=admin123
QUESTION_SECONDS=20
QUESTION_COUNT=10
WEB_PORT=8080
PG_POOL_MAX=20

# 构建/部署可变项：基础镜像与软件源（默认官方源；国内可换镜像，镜像名可带 registry 前缀）
# 基础镜像 registry 前缀（作用于 golang/alpine/node/nginx/postgres/redis 全部镜像）
# 留空=官方 Docker Hub；内网/镜像仓库示例（需以 / 结尾）：
#IMAGE_REGISTRY=docker.1ms.run/
#IMAGE_REGISTRY=registry.example.com/docker/
# 软件源统一开关：留空=官方源；SOURCE_MIRROR=cn 一键切国内镜像（Go=npm=apk 同时生效）
#SOURCE_MIRROR=cn
