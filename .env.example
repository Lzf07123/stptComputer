# 复制为 .env 使用（.env 不入库）。以下均为占位默认值，无任何真实配置。
ADMIN_PASSWORD=admin123
QUESTION_SECONDS=20
QUESTION_COUNT=10
WEB_PORT=8080

# 构建/部署可变项：基础镜像与软件源（默认官方源；国内可换镜像，镜像名可带 registry 前缀）
#GOLANG_IMAGE=golang:1.22-alpine
#ALPINE_IMAGE=alpine:3.20
#NODE_IMAGE=node:20-alpine
#NGINX_IMAGE=nginx:1.27-alpine
#POSTGRES_IMAGE=postgres:15-alpine
#REDIS_IMAGE=redis:7-alpine
# 软件源统一开关：留空=官方源；SOURCE_MIRROR=cn 一键切国内镜像（Go=npm=apk 同时生效）
#SOURCE_MIRROR=cn
